{
  "name": "verdict-web",
  "version": "0.1.0",
  "private": true,
  "description": "VERDICT live web app: reads (and, with a per-browser testnet burner, writes) the deployed JudgeRouter on GenLayer studionet.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "browser:install": "playwright install chromium",
    "test": "node --test --test-concurrency=1 test/offline.test.mjs test/ledger.test.mjs test/evidence.test.mjs test/settlement.test.mjs",
    "test:live": "node test/live.test.cjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "esbuild": "0.25.11",
    "playwright": "1.63.0"
  }
}
