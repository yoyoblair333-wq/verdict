{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdict.example/schemas/practice-rules.v1.json",
  "title": "VERDICT practice-court secret rules (Jailbreak the Jury)",
  "description": "Reviewed list of secret rules. Only `topic` is ever sent to a browser. The relayer also runs the rubric and house take through its own rubric/entry checks and refuses the whole file on any failure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "period", "timezone", "rules"],
  "properties": {
    "schema": { "const": "verdict.practice-rules.v1" },
    "period": { "enum": ["daily", "weekly"] },
    "timezone": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "rubric", "house_take", "reviewed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
          "topic": { "type": "string", "pattern": "^[a-z][a-z ]{1,23}$" },
          "rubric": { "type": "string", "minLength": 1, "maxLength": 200 },
          "house_take": { "type": "string", "minLength": 1, "maxLength": 280 },
          "reviewed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "at"],
            "properties": {
              "by": { "type": "string", "minLength": 1 },
              "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    }
  }
}
